# Copy to server/.env. Never commit the real file.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Proxy hops in front of the server (1 on Render).
TRUST_PROXY=0

# Supabase Dashboard > Connect > Session pooler (port 5432, IPv4). URL-encode special
# characters in the password. The application tables live in the private "app" schema.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app
# Same database, separate schema used and wiped by the integration tests.
TEST_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app_test

# Supabase Dashboard > Project Settings > API.
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server only.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still signs tokens with the legacy HS256 secret
# (Project Settings > JWT Keys). Leave empty when JWT signing keys are in use.
SUPABASE_JWT_SECRET=

# Key of the keyed email hash (NFR-8). At least 32 characters: openssl rand -hex 32
EMAIL_HASH_SECRET=

# Password given to the ten demonstration accounts by npm run db:seed (15 to 72 characters).
SEED_PASSWORD=

# Only in the demonstration environment: lets npm run db:reseed erase every platform row, stored
# image and non-demonstration auth user before seeding again (NFR-9). Never set in production.
DEMO_ENVIRONMENT=false
